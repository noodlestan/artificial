---
import SiteLogo from './SiteLogo.astro';
---

<header role="banner">
  <a class="site-title" href="/">
    <SiteLogo />
  </a>
  <nav aria-label="Site pages">
    <a href="/about">About</a>
  </nav>
  <div class="links">
    <a class="icon-link" href="https://github.com/noodlestan/art-md" aria-label="Art MD on GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentcolor"
          d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7 0-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"
        ></path>
      </svg>
    </a>
    <a class="icon-link" href="https://noodlestan.org" aria-label="Noodlestan website">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentcolor"
          d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm7.6 9h-2.1a15.6 15.6 0 0 0-2.1-5.6A8 8 0 0 1 19.6 11ZM12 4.1a14 14 0 0 1 2.7 5.4H9.3A14 14 0 0 1 12 4.1ZM4.4 11a8 8 0 0 1 3.9-5.5A15.6 15.6 0 0 0 6.5 11Zm0 2a15.6 15.6 0 0 0 1.8 5.3 8 8 0 0 1-1.8-5.3Zm2.6 0h2.1a14 14 0 0 0 2.1 5.6A8 8 0 0 1 7 13ZM12 19.9a14 14 0 0 1-2.7-5.4h5.4A14 14 0 0 1 12 19.9ZM15.1 13a14 14 0 0 1-2.1 5.6 8 8 0 0 1 2.1-5.6ZM15.8 11a13.9 13.9 0 0 1-1.9-5.2 8 8 0 0 1 4.4 5.2Zm3.2 2.4a8 8 0 0 1-2.3 5.2 15.6 15.6 0 0 0 2.3-5.2Z"
        ></path>
      </svg>
    </a>
  </div>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: #88fcd4;
    background: linear-gradient(
      180deg,
      var(--color-gradient-1) 6%,
      var(--color-gradient-2) 6%,
      var(--color-gradient-3)  84%
    );
  }

  .site-title {
    height: 3.5rem;
    color: var(--color-content);
  }

  nav {
    display: flex;
    gap: 1rem;
  }

  .links {
    margin-inline-start: auto;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  svg {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }
</style>
