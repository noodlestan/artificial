<style>
  footer {
    padding-block: 7rem 3rem;
    background: linear-gradient(
      180deg,
      var(--color-gradient-3) 60%,
      var(--color-gradient-2) 95%
    );
  }

  .copyright {
    font-family: var(--type-headings-family);
    font-size: 1.2rem;
    font-weight: 400;
  }

  footer,
  .legal,
  .notices {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .legal,
  .notices {
    gap: 0.25rem;
  }

  .legal {
    font-family: var(--type-headings-family);
    font-size: 0.8rem;
    font-weight: 100;
  }
</style>
