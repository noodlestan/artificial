<footer>
  <div class="container copyright">
    <p class="small">
      <span class="year">Copyright © 2026</span>{' '}
      <a href="https://noodlestan.org">Noodlestan</a>
    </p>
  </div>
  <div class="container legal text-small">
    <p class="license">Code and content available on <a class="external-link" href="https://github.com/noodlestan/"><span>GitHub</span></a> under an <a class="external-link" href="https://noodlestan.mit-license.org/"><span>MIT LICENSE</span></a>.</p>
