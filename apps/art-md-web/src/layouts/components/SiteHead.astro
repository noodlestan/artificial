---
const { title, description } = Astro.props.content;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />

<link rel="preconnect" href="https://fonts.bunny.net" />
<link
  href="https://fonts.bunny.net/css?family=ibm-plex-mono:200,200i,300,300i,400,400i,500,500i,600,600i,700,700i|literata:200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i|open-sans:300,300i,400,400i,500,500i,600,600i,700,700i,800,800i"
  rel="stylesheet"
/>

<meta name="theme-color" content="#00d590" />
<link rel="icon" href="/icon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
