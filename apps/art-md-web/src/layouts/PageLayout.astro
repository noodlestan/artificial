---
import '../styles/global.css'
import SiteHead from './components/SiteHead.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const { content } = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead content={content}/>
  </head>
  <body>
    <SiteHeader />
    <main class="main-section markdown">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main {
    padding-block-start: 2rem;
  }
</style>
