---
import '../styles/global.css';
import SiteHead from './components/SiteHead.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import HomeIntro from '../components/pages/home/HomeIntro.astro';
import HomeDemo from '../components/pages/home/HomeDemo.astro';

const { content } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead content={content} />
  </head>
  <body>
    <HomeIntro />
    <main class="main-section markdown">
      <HomeDemo />
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
