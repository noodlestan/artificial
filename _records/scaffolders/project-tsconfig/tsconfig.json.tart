{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "rootDir": ".",
    "allowJs": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": [],
    // module
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // emit
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // strict
    "strict": true,
    "noImplicitAny": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    // root specific
    "skipLibCheck": true, // problems in vitest, @vitest/utils, svgo
    "noEmit": true
  },
  "include": [
::TEMPLATE for each `%namespace` in `%project.namespaces`
    "{{%namespace.path}}",
::END
  ],
  "exclude": ["**/node_modules/", "**/dist/", "**/coverage/"]
}
