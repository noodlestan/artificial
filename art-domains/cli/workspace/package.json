{
  "name": "@art-domains/workspace-cli",
  "version": "0.0.11",
  "description": "Workspace orchestration CLI",
  "type": "module",
  "bin": {
    "art-workspace": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --format=esm --packages=external && esbuild src/config/index.ts --bundle --platform=node --outfile=dist/config/index.js --format=esm --packages=external && tsc --emitDeclarationOnly",
    "dev": "npm run build -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ && tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "esbuild": "^0.28.0",
    "simple-git": "^3.24.0"
  },
  "devDependencies": {
    "@noodlestan/esbuild": "^0.0.11",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
