{
  "name": "@art-js/poc-parse",
  "version": "0.0.1",
  "description": "POC spike of the artificials parser: a self-contained, CLI-executable package.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/no-comply.git",
    "directory": "art-js/cli/poc-parse"
  },
  "type": "module",
  "module": "dist/esm/index.mjs",
  "main": "dist/cjs/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "types": "./dist/esm/index.d.ts",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build:clean": "rm -rf dist",
    "test": "bash scripts/test-fixtures.sh",
    "ci": "npm run lint && npm run test"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.0",
    "unist-util-visit": "^5.0.0"
  }
}
