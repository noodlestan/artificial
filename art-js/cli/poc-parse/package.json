{
  "name": "@art-js/poc-parse",
  "version": "0.0.1",
  "description": "POC spike of the artificials parser: a self-contained, CLI-executable package.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
