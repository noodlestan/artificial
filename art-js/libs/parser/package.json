{
  "name": "@art-js/artificial-parser",
  "version": "0.0.1",
  "description": "Parses context files and art modules into structured representations.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/artificial",
    "directory": "libs/parser/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "dist",
    "LICENSE-MIT",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build:clean": "rm -rf dist",
    "ci": "npm run lint && npm run build && npm run test",
    "test-parser": "npx tsx scripts/test-parser.ts",
    "test-serializer": "npx tsx scripts/test-serializer.ts",
    "test": "npm run test-parser && npm run test-serializer"
  },
  "dependencies": {
    "@art-js/artificial-primitives": "*",
    "@art-js/artificial-constructs": "*",
    "mdast-util-from-markdown": "^2.0.0",
    "unist-util-visit": "^4.0.0"
  },
  "devDependencies": {
    "@art-js/artificial-serializer": "*",
    "tsx": "^4.8.1",
    "vite": "8.0.16",
    "vite-plugin-solid": "2.11.12"
  }
}
