{
  "name": "@art-js/artificial-parser",
  "version": "0.0.1",
  "description": "Parses context files and art modules into structured representations.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/no-comply.git",
    "directory": "libs/parser/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "src",
    "LICENSE-MIT"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build:clean": "rm -rf dist",
    "ci": "npm run lint && npm run build && npm run test",
    "test": "npx tsx scripts/run-snapshot-check.ts"
  },
  "dependencies": {
    "@art-js/artificial-primitives": "*",
    "mdast-util-from-markdown": "^2.0.0",
    "unist-util-visit": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "solid-js": "1.9.13",
    "tsx": "^4.8.1",
    "vite": "8.0.16",
    "vite-plugin-solid": "2.11.12",
    "vite-plugin-solid-svg": "0.8.1",
    "vite-plugin-top-level-await": "1.6.0"
  }
}
